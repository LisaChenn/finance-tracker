PLAID_CLIENT_ID=your_plaid_client_id

# Plaid gives you a separate secret per environment. Set the one(s) you use;
# the app picks the right secret based on PLAID_ENV below.
PLAID_SANDBOX_SECRET=your_plaid_sandbox_secret
PLAID_PRODUCTION_SECRET=your_plaid_production_secret

# sandbox | production
PLAID_ENV=sandbox

PORT=8080
